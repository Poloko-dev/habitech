# MongoDB connection string (MONGO_DB or MONGODB_URI both work).
# The database name comes from the URI path (here: habitech); MONGODB_DB overrides it.
# Without it, the app stores data in ./storage.json instead.
MONGO_DB=mongodb://localhost:27017/habitech

# Optional: a fixed access token. If not set, you create the token in the app on
# first launch and it is stored hashed in MongoDB.
# PASS_TOKEN=change-me
