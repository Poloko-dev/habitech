# Token required to unlock the app (keep the real value in .env, never commit it)
PASS_TOKEN=change-me

# Optional locally (without it, data is stored in ./storage.json).
# Required on Vercel: MongoDB Atlas connection string.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=habitech
