# Token required to unlock the app (keep the real value in .env, never commit it)
PASS_TOKEN=change-me

# MongoDB connection string – MONGO_DB or MONGODB_URI (either name works).
# Optional locally (without it, data is stored in ./storage.json); required on Vercel.
# The database name is taken from the URI path (default: habitech); MONGODB_DB overrides it.
MONGO_DB=mongodb://localhost:27017/habitech
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/habitech?retryWrites=true&w=majority
